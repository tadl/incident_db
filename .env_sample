# Optional for local use. Set registered Google OAuth credentials in .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_DOMAIN=example.org
DEV_HOSTNAME=

# Comma-separated staff email addresses for each permission.
CAN_EDIT=
CAN_SUSPEND=
SUPER_ADMIN=

# Optional comma-separated recipients for suspension expiration notices.
# Leave unset to use CAN_SUSPEND. Set an empty value to disable expiration notices.
# UNSUSPEND_EMAIL_TO=
