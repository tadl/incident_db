<section id="patron_<%= patron.id %>" class="patron_violation_form card mb-3">
  <div class="card-body">
    <div id="patron_image_<%= patron.id %>">
      <% if patron.images.first %>
        <%= image_tag private_thumbnail_path(patron.images.first), class: 'img-thumbnail' %>
      <% end %>
    </div>
    <h2 class="h4"><%= patron.full_name %></h2>
    <% if patron.is_suspended %>
      <p>Suspended until <%= patron.suspended_until %></p>
    <% end %>
    <% suspension = patron.suspension_for(incident.id) %>
    <div class="mb-3">
      <button type="button" class="btn btn-outline-secondary btn-sm" data-patron-action="edit" data-patron-id="<%= patron.id %>">Edit patron record</button>
      <% if !suspension || current_user.can_suspend %>
        <button type="button" class="btn btn-outline-danger btn-sm" data-patron-action="remove" data-patron-id="<%= patron.id %>">Remove patron from incident</button>
      <% end %>
      <% if current_user.can_suspend %>
        <button type="button" class="btn btn-outline-danger btn-sm" data-patron-action="suspension-form" data-patron-id="<%= patron.id %>"><%= suspension ? 'Edit suspension' : 'Suspend patron' %></button>
      <% end %>
    </div>
    <% historical = patron.historical_violations_for(incident.id) %>
    <% if historical.present? %>
      <p class="mb-1"><strong>Previous violation codes</strong></p>
      <ul>
        <% historical.each do |entry| %>
          <li><%= entry %></li>
        <% end %>
      </ul>
    <% end %>
    <label class="form-label" for="violation_summary_<%= patron.id %>">Violation summary</label>
    <textarea id="violation_summary_<%= patron.id %>" class="form-control violation-summary" rows="4" name="violation_summaries[<%= patron.id %>][description]"><%= patron.violation_summary_for(incident.id)&.description %></textarea>
    <div id="suspension_modal_container_<%= patron.id %>"></div>
    <div id="patron_edit_modal_containter_<%= patron.id %>"></div>
  </div>
</section>
