<% if @patrons.blank? %>
  <p>No patrons found.</p>
<% end %>
<% @patrons.each do |patron| %>
  <div class="row mt-3 mb-3">
    <% if (picture = patron.images.first) %>
      <div class="col-auto">
        <%= render "shared/image_thumbnail", attachment: picture, label: "Patron image", compact: true %>
      </div>
    <% end %>
    <div class="col">
      <h3 class="h5"><%= patron.full_name %></h3>
      <% if patron.description.present? %>
        <p><%= patron.description %></p>
      <% end %>
      <% incidents = patron.published_incidents.limit(4) %>
      <% if incidents.present? %>
        <p class="mb-1"><strong>Recent incidents</strong></p>
        <ul>
          <% incidents.each do |incident| %>
            <li><%= link_to incident.title, incidents_view_path(id: incident.id) %></li>
          <% end %>
        </ul>
      <% end %>
      <button type="button" data-patron-action="add" data-patron-id="<%= patron.id %>" data-patron-name="<%= patron.full_name(show_call_911: false) %>" class="btn btn-primary btn-sm">Add patron to incident</button>
      <%= link_to 'View patron record', patrons_view_path(id: patron.id), class: 'btn btn-outline-secondary btn-sm', target: '_blank', rel: 'noopener' %>
    </div>
  </div>
<% end %>
