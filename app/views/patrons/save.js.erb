<% if @errors %>
  $('#patron_messages_<%= @patron.id %>').text('<%= escape_javascript(@errors.to_sentence) %>').addClass('text-danger');
<% elsif @editing_without_incident %>
  window.location.assign('<%= patrons_view_path(id: @patron.id) %>');
<% elsif @edit %>
  $('#patron_edit_modal_<%= @patron.id %>').one('hidden.bs.modal', function () {
    const summary = $('#violation_summary_<%= @patron.id %>').val();
    $('#patron_<%= @patron.id %>').replaceWith("<%= escape_javascript(render 'add_violation', patron: @patron, incident: @incident) %>");
    $('#violation_summary_<%= @patron.id %>').val(summary);
  });
  bootstrap.Modal.getInstance(document.getElementById('patron_edit_modal_<%= @patron.id %>')).hide();
<% else %>
  $('#add_patron').empty();
  $('#patron_list').append("<%= escape_javascript(render 'add_violation', patron: @patron, incident: @incident) %>");
  $('#save_incident_buttons, #add_patron_to_incident_button').show();
<% end %>
