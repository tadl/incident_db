var target_div = '#patron_pics_<%= @patron.id %>'
$(target_div).html("<%= escape_javascript(render 'patron_pics', patron: @patron)%>")
<% if @incident %>
    <% if (picture = @patron.images.first) %>
        $('#patron_image_<%= @patron.id %>').html("<%= escape_javascript(render('shared/image_thumbnail', attachment: picture, label: 'Patron image', compact: true)) %>");
    <% else %>
        $('#patron_image_<%= @patron.id %>').html('')
    <% end %>
<% end %>
