<% content_for :title, "Search patrons" %>

<%= render "shared/section_heading", glyph: "person", heading: "Search Patrons" %>
<%= render "section_links" %>
<%= form_with url: patrons_search_path, method: :post, local: true, class: "staff-search" do %>
  <%= render "shared/search_fields", label: "Patron name or keywords", field_id: "patron-query" %>
  <div class="form-check mt-3">
    <%= check_box_tag :unknown_only, "true", @unknown_only, class: "form-check-input" %>
    <%= label_tag :unknown_only, "Only patrons with an unknown name", class: "form-check-label" %>
  </div>
<% end %>
<%= render "shared/search_pagination", results: @patrons, path: patrons_search_path,
           filters: { query: @query, unknown_only: @unknown_only }, position: "top" %>
<% @patrons.each do |patron| %>
  <article class="card record-card mb-3">
    <div class="card-body">
      <%= render "patron_full", p: patron, stub: true %>
    </div>
  </article>
<% end %>
<% if @patrons.empty? && (@query.present? || @unknown_only) %>
  <%= render "shared/empty_results", message: "No patrons match your search." %>
<% end %>
<%= render "shared/search_pagination", results: @patrons, path: patrons_search_path,
           filters: { query: @query, unknown_only: @unknown_only }, position: "bottom" %>
