<% content_for :title, "Patrons" %>

<%= render "shared/section_heading", glyph: "person", heading: @title %>
<%= render "section_links" %>
<%= render "shared/list_pagination", records: @patrons, position: "top" %>
<% @patrons.each do |patron| %>
  <article class="card record-card mb-3">
    <div class="card-body">
      <%= render "patron_full", p: patron, stub: true %>
    </div>
  </article>
<% end %>
<%= render "shared/empty_results", message: "No patrons in this view." if @patrons.empty? %>
<%= render "shared/list_pagination", records: @patrons, position: "bottom" %>
