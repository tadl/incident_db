<% patron.images.each do |i| %>
    <div class="col-lg-3 col-md-6">
        <a href="<%= private_attachment_path(i) %>" target="_blank">
            <%= image_tag private_thumbnail_path(i), class: 'img-thumbnail' %>
        </a>
        <br>
        <button type="button" class="btn btn-danger btn-sm mb-1 mt-1" data-patron-action="delete-image" data-image-id="<%= i.id %>" data-patron-id="<%= patron.id %>">
            <%= icon('fa-solid', 'trash') %> Delete Image
        </button>
    </div>
<% end %>
