<div class="<%= "card record-section mb-4" unless stub %>">
  <div class="<%= "card-body" unless stub %>">
    <div class="record-title-row mb-2">
      <% name = p.full_name(show_call_911: false).presence || "Unknown patron" %>
      <h2 class="card-title">
        <% if stub %>
          <%= link_to name, patrons_view_path(id: p.id) %>
        <% else %>
          <%= name %>
        <% end %>
      </h2>
      <% if p.call_911? %>
        <span class="status-label-urgent">Call 911 immediately if seen on property</span>
      <% end %>
    </div>
    <%= render "shared/record_details", details: {
      "Suspended until" => p.suspended_until,
      "Address" => p.full_address,
      "Library card number" => p.card_number
    } %>
    <%= render "shared/record_images", label: "Patron", attachments: stub ? p.images.first(1) : p.images %>
    <% if p.description.present? %>
      <p class="record-description"><%= p.description %></p>
    <% end %>
    <% incidents = stub ? p.published_incidents.limit(2) : p.published_incidents %>
    <% if incidents.any? %>
      <section class="patron-incidents">
        <h3 class="h6"><%= stub ? "Recent incidents" : "Incidents" %></h3>
        <% incidents.each do |incident| %>
          <article class="related-incident">
            <h4 class="h6"><%= link_to incident.title, incidents_view_path(id: incident.id) %></h4>
            <p class="record-related"><%= incident.date_of_in_time_zone_minus_time %></p>
            <strong>Violations</strong>
            <%= render "shared/violation_notes", patron: p, incident: incident %>
            <%= render "shared/suspension_details", patron: p, incident_id: incident.id %>
          </article>
        <% end %>
      </section>
    <% end %>
    <div class="record-actions">
      <%= link_to "Edit patron record", patrons_edit_path(patron_id: p.id), class: "btn btn-outline-primary btn-sm" %>
      <% if stub && current_user.is_super_admin %>
        <button type="button" data-patron-action="delete" data-patron-id="<%= p.id %>" class="btn btn-outline-danger btn-sm">Delete patron</button>
      <% end %>
    </div>
  </div>
</div>
