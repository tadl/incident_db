<section class="card mb-3">
  <div class="card-body">
    <h2 class="h4">Find an existing patron</h2>
    <button type="button" class="btn btn-outline-secondary btn-sm mb-3" data-patron-action="load-new">Create a patron record</button>
    <label for="patron_query" class="form-label">Search patrons</label>
    <div class="input-group mb-3">
      <input type="search" class="form-control" id="patron_query" autocomplete="off">
      <button type="button" class="btn btn-primary" data-patron-action="search">Search</button>
    </div>
    <div id="search_results"></div>
    <button type="button" class="btn btn-outline-secondary" data-patron-action="cancel">Cancel</button>
  </div>
</section>
