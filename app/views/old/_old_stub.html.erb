<article class="card record-card mb-3">
  <div class="card-body">
    <div class="record-preview">
      <%= render "shared/image_thumbnail", attachment: r.primary_pic, label: "Legacy report ##{r.legacy_id.presence || r.id}", record_path: old_view_path(id: r.id) %>
      <div class="record-preview-content">
        <h2 class="card-title"><%= link_to r.title.presence || "Legacy report", old_view_path(id: r.id) %></h2>
        <ul class="record-meta">
          <li><%= r.date_of_pretty %> <%= r.time_of_in_zone %></li>
          <% if r.location.present? %>
            <li><%= r.location %></li>
          <% end %>
          <li>Report #<%= r.legacy_id %></li>
        </ul>
        <p class="record-description"><%= truncate(r.description, length: 400, separator: /\s/) %></p>
        <% if r.patron_name.present? %>
          <p class="record-related"><strong>Patron involved</strong> <%= r.patron_name %></p>
        <% end %>
        <% if r.has_violations? %>
          <p class="record-related"><strong>Violations</strong> <%= r.violations %></p>
        <% end %>
        <% if r.suspension == "Yes" %>
          <p class="record-related"><strong>Suspension</strong> <%= r.suspension_duration %></p>
        <% end %>
      </div>
    </div>
  </div>
</article>
