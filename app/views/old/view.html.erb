<% content_for :title, "Legacy report" %>

<h1><%= @report.title.presence || "Legacy report" %></h1>
<section class="card record-section" aria-label="Legacy report details">
  <div class="card-body">
    <%= render "shared/record_details", details: {
      "Incident date" => [@report.date_of_pretty, @report.time_of_in_zone].compact.join(" "),
      "Location" => @report.location,
      "Submitted by" => @report.submitted_by,
      "Report number" => @report.legacy_id
    } %>
    <%= render "shared/record_images", label: "Legacy report", attachments: @report.images %>

    <% if @report.description.present? %>
      <h2 class="h5">Description</h2>
      <p class="record-description"><%= @report.description %></p>
    <% end %>
    <% if @report.narrative.present? %>
      <h2 class="h5 mt-3">Staff narrative</h2>
      <p class="record-description"><%= @report.narrative %></p>
    <% end %>
    <% if @report.patron_name.present? %>
      <p class="record-related"><strong>Patron involved</strong> <%= @report.patron_name %></p>
    <% end %>
    <% if @report.has_violations? %>
      <p class="record-related"><strong>Violations</strong> <%= @report.violations %></p>
    <% end %>
    <% if @report.suspension == "Yes" %>
      <p class="record-related"><strong>Suspension</strong> <%= @report.suspension_duration %></p>
    <% end %>
  </div>
</section>
