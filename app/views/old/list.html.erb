<% content_for :title, "Legacy reports" %>

<%= render "shared/section_heading", glyph: "box-archive", heading: "Legacy Incident Reports" %>
<div class="list-toolbar">
  <%= render "section_links" %>
  <%= render "shared/list_pagination", records: @reports, position: "top" %>
</div>
<% @reports.each do |report| %>
  <%= render "old_stub", r: report %>
<% end %>
<%= render "shared/empty_results", message: "No legacy reports in this view." if @reports.empty? %>
<%= render "shared/list_pagination", records: @reports, position: "bottom" %>
