<% content_for :title, "Search legacy reports" %>

<h1>Search Legacy Reports</h1>
<%= render "section_links" %>
<%= form_with url: old_search_path, method: :post, local: true, class: "staff-search" do %>
  <%= render "shared/search_fields", label: "Legacy report keywords", field_id: "legacy-query" %>
<% end %>
<% @reports.each do |report| %>
  <%= render "old_stub", r: report %>
<% end %>
<% if @reports.empty? && @query.present? %>
  <%= render "shared/empty_results", message: "No legacy reports match your search." %>
<% end %>
<%= render "shared/search_pagination", results: @reports, path: old_search_path, filters: { query: @query } %>
