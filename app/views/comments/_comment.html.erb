<article id="<%= dom_id(comment, :entry) %>" class="card mb-3">
  <div class="card-body">
    <header class="d-flex flex-wrap align-items-baseline gap-2">
      <strong><%= comment.submitted_by %></strong>
      <span class="small text-body-secondary"><%= comment.posted_on %></span>
      <% if comment.was_edited %>
        <span class="small text-body-secondary">Edited <%= comment.edited_on %></span>
      <% end %>
    </header>
    <p class="mt-2"><%= safe_join(comment.description.to_s.lines, tag.br) %></p>

    <% if current_user.my_comment(comment) %>
      <details data-comment-editor>
        <summary>Edit comment</summary>
        <%= form_with url: comments_update_path, class: "mt-2" do |form| %>
          <%= form.hidden_field :comment_for, value: from, id: nil %>
          <%= form.hidden_field :owner_id, value: owner_id, id: nil %>
          <%= form.hidden_field :id, value: comment.id, id: nil %>
          <% field_id = dom_id(comment, :description) %>
          <%= form.label :description, "Comment", for: field_id, class: "form-label" %>
          <%= form.text_area :description, value: comment.description, id: field_id, required: true,
            maxlength: 16_000, rows: 4, class: "form-control mb-2" %>
          <%= form.submit "Save changes", class: "btn btn-sm btn-primary" %>
          <%= form.button "Cancel", type: :reset, class: "btn btn-sm btn-outline-secondary" %>
        <% end %>
        <%= form_with url: comments_delete_path, class: "mt-2" do |form| %>
          <%= form.hidden_field :comment_for, value: from, id: nil %>
          <%= form.hidden_field :owner_id, value: owner_id, id: nil %>
          <%= form.hidden_field :id, value: comment.id, id: nil %>
          <%= form.button "Delete comment", type: :button, class: "btn btn-sm btn-outline-danger",
            data: { confirm_form: true, confirm_title: "Delete comment?", confirm_label: "Delete comment",
              confirm_message: "The comment will be removed from this record." } %>
        <% end %>
      </details>
    <% end %>
  </div>
</article>
