<section class="record-section mt-4" id="comments" aria-labelledby="comments-heading">
  <h2 id="comments-heading" class="h4">Extra information</h2>
  <% comments.includes(:user).order(:created_at, :id).each do |comment| %>
    <%= render "comments/comment", comment: comment, from: from, owner_id: owner_id %>
  <% end %>

  <%= form_with url: comments_save_path do |form| %>
    <%= form.hidden_field :comment_for, value: from %>
    <%= form.hidden_field :owner_id, value: owner_id %>
    <div class="mb-3">
      <%= form.label :description, "Add extra information", class: "form-label" %>
      <%= form.text_area :description, rows: 4, required: true, maxlength: 16_000, class: "form-control" %>
    </div>
    <%= form.submit "Save extra information", class: "btn btn-primary" %>
    <%= form.button "Cancel", type: :reset, class: "btn btn-outline-secondary" %>
  <% end %>
</section>
