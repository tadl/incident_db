<article class="card record-card mb-3">
  <div class="card-body">
    <div class="record-preview">
      <%= render "shared/image_thumbnail", attachment: i.primary_pic, label: "Report ##{i.id}", record_path: incidents_view_path(id: i.id) %>
      <div class="record-preview-content">
        <div class="record-title-row">
          <h2 class="card-title"><%= link_to i.title.presence || "Incident report", incidents_view_path(id: i.id) %></h2>
          <% if i.draft? %>
            <span class="status-label">Draft</span>
          <% end %>
        </div>
        <ul class="record-meta">
          <li><%= i.date_of_in_time_zone %></li>
          <li><%= i.location %></li>
          <li>Report #<%= i.id %></li>
        </ul>
        <p class="record-description"><%= truncate(i.description, length: 400, separator: /\s/) %></p>
        <% if (patrons = i.patrons).any? %>
          <p class="record-related"><strong>Patrons involved</strong>
            <%= safe_join(patrons.map { |patron| link_to patron.full_name, patrons_view_path(id: patron.id) }, ", ") %>
          </p>
        <% end %>
        <% if current_user.can_edit_incident(i) %>
          <div class="record-actions">
            <%= link_to "Edit", incidents_edit_path(id: i.id), class: "btn btn-sm btn-outline-primary",
                        aria: { label: "Edit report ##{i.id}" } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</article>
