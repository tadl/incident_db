<% if @updated %>
  $('#messages').empty();
  <% if @add_patron %>
    $('#add_patron').html("<%= escape_javascript(render 'add_patron_form', patron: Patron.new) %>").show();
    $('#incident_id').text('<%= @incident.id %>');
    $('#incident_pics').html("<%= escape_javascript(render 'incident_pics') %>");
    $('#incident_images').val('');
    $('#add_patron_to_incident_button, #save_incident_buttons').hide();
    window.history.replaceState(null, '', '<%= incidents_edit_path(id: @incident.id) %>');
  <% else %>
    window.location.assign('<%= incidents_view_path(id: @incident.id) %>');
  <% end %>
<% else %>
  $('#messages').text('<%= escape_javascript(@errors.to_sentence) %>').addClass('text-danger');
<% end %>
