<section class="card mb-3">
  <div class="card-body">
    <%= render 'incident_form' %>
  </div>
</section>
<div id="patron_list">
  <% @incident.patrons.each do |patron| %>
    <%= render 'patrons/add_violation', patron: patron, incident: @incident %>
  <% end %>
</div>
<div id="add_patron_to_incident_button" class="mb-3">
  <button type="button" class="btn btn-outline-primary" data-incident-action="save" data-add-patron="true" data-draft="<%= !@incident.published? %>">
    <%= icon('fa-solid', 'person') %> Add patron
  </button>
</div>
<div id="add_patron"></div>
<div id="messages" class="mb-3" role="status"></div>
<div id="save_incident_buttons" class="mb-3">
  <% if @incident.published? %>
    <button type="button" class="btn btn-primary" data-incident-action="save">Update incident</button>
  <% else %>
    <button type="button" class="btn btn-primary" data-incident-action="save">Publish incident</button>
    <button type="button" class="btn btn-outline-secondary" data-incident-action="save" data-draft="true">Save as draft</button>
  <% end %>
</div>
