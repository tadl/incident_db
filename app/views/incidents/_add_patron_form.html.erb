<div class="card mb-3">
  <div class="card-body">
    <h2 class="h4">Create a patron record</h2>
    <button type="button" class="btn btn-outline-secondary btn-sm" data-patron-action="load-search">Find an existing patron</button>
    <%= render 'patrons/patron_form', patron: patron %>
    <button type="button" class="btn btn-primary" data-patron-action="save">Add patron to incident</button>
    <button type="button" class="btn btn-outline-secondary" data-patron-action="cancel">Cancel</button>
  </div>
</div>
