<% content_for :title, "#{@title} incidents" %>

<%= render "shared/section_heading", glyph: "person-falling-burst", heading: "#{@title} Incidents" %>
<div class="list-toolbar">
  <%= render "section_links" %>
  <%= render "shared/list_pagination", records: @incidents, position: "top" %>
</div>
<% @incidents.each do |incident| %>
  <%= render "incident_stub", i: incident %>
<% end %>
<%= render "shared/empty_results", message: "No incidents in this view." if @incidents.empty? %>
<%= render "shared/list_pagination", records: @incidents, position: "bottom" %>
