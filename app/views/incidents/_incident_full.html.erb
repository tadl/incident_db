<% content_for :title, "Incident report" %>

<div class="record-title-row mb-3">
  <h1 class="mb-0"><%= @incident.title %></h1>
  <% if @incident.draft? %>
    <span class="status-label">Draft</span>
  <% end %>
</div>
<section class="card record-section mb-4" aria-label="Incident report details">
  <div class="card-body">
    <%= render "shared/record_details", details: {
      "Incident date" => @incident.date_of_in_time_zone,
      "Location" => @incident.location,
      "Submitted by" => @incident.created_by_name,
      "Report number" => @incident.id
    } %>
    <%= render "shared/record_images", label: "Incident", attachments: @incident.images %>
    <h2 class="h5">Description</h2>
    <p class="record-description"><%= @incident.description %></p>
  </div>
</section>

<% if @incident.patrons.any? %>
  <section class="mb-4" aria-labelledby="involved-patrons-heading">
    <h2 id="involved-patrons-heading" class="h4">Patrons involved</h2>
    <% @incident.patrons.each do |patron| %>
      <article class="card record-section mb-3">
        <div class="card-body">
          <div class="record-title-row mb-2">
            <h3 class="h5 mb-0">
              <%= link_to patron.full_name(show_call_911: false), patrons_view_path(id: patron.id) %>
            </h3>
            <% if patron.call_911? %>
              <span class="status-label-urgent">Call 911 immediately if seen on property</span>
            <% end %>
          </div>
          <% if (picture = patron.images.first) %>
            <%= render "shared/record_images", label: "Patron", attachments: [picture] %>
          <% end %>
          <strong>Violations</strong>
          <%= render "shared/violation_notes", patron: patron, incident: @incident %>
          <%= render "shared/suspension_details", patron: patron, incident_id: @incident.id %>
        </div>
      </article>
    <% end %>
  </section>
<% end %>
