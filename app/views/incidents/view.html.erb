<% content_for :title, "Incident report" %>
<% can_edit = current_user.can_edit_incident(@incident) %>
<% can_delete = current_user.can_delete_this_incident(@incident) %>
<header class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
  <div class="record-title-row">
    <h1 class="mb-0"><%= @incident.title %></h1>
    <% if @incident.draft? %>
      <span class="status-label">Draft</span>
    <% end %>
  </div>
  <% if can_edit || can_delete %>
    <div class="record-actions mt-0">
      <% if can_edit %>
        <%= link_to "Edit incident", incidents_edit_path(id: @incident.id), class: "btn btn-primary" %>
      <% end %>
      <%= render "delete_button", incident: @incident if can_delete %>
    </div>
  <% end %>
</header>
<%= render "incident_full" %>
<%= render "comments/comments", comments: @incident.incident_comments, from: "incident", owner_id: @incident.id %>
