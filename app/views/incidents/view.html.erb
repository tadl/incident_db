<%= render "incident_full" %>
<% if current_user.can_edit_incident(@incident) %>
  <div class="mb-3">
    <%= link_to "Edit incident", incidents_edit_path(id: @incident.id), class: "btn btn-secondary" %>
  </div>
<% end %>
<%= render "comments/comments", comments: @incident.incident_comments, from: "incident", owner_id: @incident.id %>
