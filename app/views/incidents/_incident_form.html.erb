<div class="mb-3">
  <label for="title" class="form-label">Title</label>
  <input type="text" class="form-control" id="title" value="<%= @incident.title %>" autocomplete="off" required>
</div>
<div class="row mb-3 g-3">
  <div class="col-md-6">
    <label for="date_of" class="form-label">Date and time of incident (Eastern)</label>
    <input id="date_of" type="datetime-local" class="form-control" value="<%= @incident.date_of&.strftime('%Y-%m-%dT%H:%M') %>" required>
  </div>
  <div class="col-md-6">
    <label for="location" class="form-label">Location</label>
    <% locations = Settings.locations.to_a %>
    <% locations = locations | [@incident.location] if @incident.location.present? %>
    <%= select_tag :location, options_for_select(locations, @incident.location), prompt: "Select a location", class: "form-select", required: true %>
  </div>
</div>
<div class="mb-3">
  <label for="description" class="form-label">Description</label>
  <textarea class="form-control" id="description" rows="8" autocomplete="off" required><%= @incident.description %></textarea>
</div>
<div class="row mb-3" id="incident_pics">
  <%= render 'incident_pics' %>
</div>
<div class="mb-3">
  <label for="incident_images" class="form-label">Add incident images</label>
  <%= file_field_tag 'incident_images', multiple: true, accept: 'image/png,image/jpeg', autocomplete: "off", class: "form-control" %>
  <button type="button" class="btn btn-sm btn-outline-secondary mt-2" data-incident-action="clear-images">Clear selection</button>
</div>
<span id="incident_id" hidden><%= @incident.id %></span>
