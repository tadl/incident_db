<% @incident.images.each_with_index do |attachment, index| %>
  <div class="col-auto mb-2">
    <%= render "shared/image_thumbnail", attachment: attachment, label: "Incident image #{index + 1}" %>
    <div class="mt-1">
      <button type="button" class="btn btn-danger btn-sm" data-incident-action="delete-image" data-image-id="<%= attachment.id %>">
        <%= icon('fa-solid', 'trash') %> Delete Image
      </button>
    </div>
  </div>
<% end %>
