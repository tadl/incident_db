<header>
  <div class="staff-masthead">
    <%= image_tag "tadl-header-bg.jpg", alt: "", class: "staff-masthead-texture", aria: { hidden: true } %>
    <div class="container staff-masthead-inner">
      <%= link_to root_path, class: "staff-brand" do %>
        <%= image_tag "tadl-logo.svg", alt: "Traverse Area District Library", width: 116, height: 41 %>
        <span>Incident Reports</span>
      <% end %>
      <% if current_user %>
        <div class="staff-account">
          <span class="staff-account-name"><%= current_user.name.presence || current_user.email %></span>
          <%= button_to "Sign out", signout_path, method: :post, class: "btn btn-sm btn-outline-light" %>
        </div>
      <% end %>
    </div>
  </div>
  <% if current_user %>
    <nav class="staff-navigation" aria-label="Main navigation">
      <div class="container staff-navigation-inner">
        <ul class="nav staff-nav-links">
          <% [["Incidents", incidents_path, "incidents"], ["Patrons", patrons_list_path, "patrons"], ["Legacy", old_list_path, "old"]].each do |label, path, section| %>
            <% active = controller_name == section %>
            <li class="nav-item">
              <%= link_to label, path, class: ["nav-link", ("is-current" if active)],
                          aria: { current: ("location" if active) } %>
            </li>
          <% end %>
        </ul>
        <%= link_to incidents_new_path, class: "btn btn-primary new-incident-link" do %>
          <%= icon("fa-solid", "plus", aria: { hidden: true }) %>
          New incident
        <% end %>
      </div>
    </nav>
  <% end %>
</header>
