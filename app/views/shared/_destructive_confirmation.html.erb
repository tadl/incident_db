<dialog class="destructive-confirmation" aria-labelledby="destructive-confirmation-title"
        aria-describedby="destructive-confirmation-message" data-destructive-confirmation>
  <h2 id="destructive-confirmation-title" class="h5" data-confirmation-title></h2>
  <p id="destructive-confirmation-message" data-confirmation-message></p>
  <form method="dialog" class="destructive-confirmation-actions">
    <button type="submit" value="cancel" class="btn btn-outline-secondary" autofocus>Cancel</button>
    <button type="submit" value="confirm" class="btn btn-danger" data-confirmation-accept></button>
  </form>
</dialog>
