<% if attachments.any? %>
  <ul class="record-images" aria-label="<%= label %> images">
    <% attachments.each_with_index do |attachment, index| %>
      <li>
        <%= render "shared/image_thumbnail", attachment: attachment, label: "#{label} image #{index + 1}" %>
      </li>
    <% end %>
  </ul>
<% end %>
