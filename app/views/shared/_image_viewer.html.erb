<dialog class="image-viewer" aria-labelledby="image-viewer-title" data-image-viewer>
  <div class="image-viewer-toolbar">
    <h2 id="image-viewer-title" class="h5 mb-0" data-image-viewer-title>Image preview</h2>
    <div class="image-viewer-actions">
      <a class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener" data-image-viewer-original>Open original in a new tab</a>
      <form method="dialog">
        <button type="submit" class="btn btn-primary btn-sm" autofocus>Close</button>
      </form>
    </div>
  </div>
  <p class="image-viewer-status" role="status" data-image-viewer-status></p>
  <img alt="" data-image-viewer-picture hidden>
</dialog>
