<% if records.total_pages > 1 %>
  <% filters = request.query_parameters.slice("just_drafts", "just_mine", "suspended", "call_911") %>
  <nav aria-label="Result pages at <%= position %>" class="list-pagination">
    <div class="pagination-controls">
      <%= render "shared/pagination_controls", records: records,
                 page_url: ->(page) { url_for(only_path: true, params: filters.merge("page" => page)) } %>
    </div>
  </nav>
<% end %>
