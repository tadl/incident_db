<% if results.total_pages > 1 %>
  <nav aria-label="Search result pages at <%= position %>" class="search-pagination">
    <%= form_with url: path, method: :post, local: true, class: "pagination-controls" do %>
      <% filters.each do |name, value| %>
        <%= hidden_field_tag name, value, id: nil %>
      <% end %>
      <%= render "shared/pagination_controls", records: results, page_url: nil %>
    <% end %>
  </nav>
<% end %>
